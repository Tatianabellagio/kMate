#!/bin/bash
#SBATCH --job-name=nb_controlled
#SBATCH --account=co_moilab
#SBATCH --partition=savio4_htc
#SBATCH --qos=savio_lowprio
#SBATCH --cpus-per-task=2
#SBATCH --mem=16G
#SBATCH --time=1:00:00
#SBATCH --output=/global/scratch/users/tbellg/kmate/analysis/grenenet_gea/gea_newpanel/_regen2_logs/nb_controlled_%j.log
#SBATCH --error=/global/scratch/users/tbellg/kmate/analysis/grenenet_gea/gea_newpanel/_regen2_logs/nb_controlled_%j.log
# Build (kmate) + execute (basic) the controlled-figures notebook (embeds lf_rank / msr /
# betabinom / quasibinom figures — all freshly regenerated by the prior-agent chains).
set -euo pipefail
cd /global/scratch/users/tbellg/kmate/analysis/grenenet_gea/gea_newpanel
PYK=/global/home/users/tbellg/miniforge3/envs/kmate/bin/python
NBX=/global/home/users/tbellg/miniforge3/envs/basic/bin/jupyter
$PYK -u _build_controlled_figs_nb.py
$NBX nbconvert --to notebook --execute --inplace \
  --ExecutePreprocessor.timeout=3600 notebooks/controlled_figures.ipynb
echo DONE_NB_CONTROLLED
