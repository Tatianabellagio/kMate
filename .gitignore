# =============================================================================
# .gitignore for kmate
# Track: code (.py, .sh), docs (.md), small config (manifests, ecotype lists)
# Don't track: large intermediate data, fastqs, BAMs, VCFs, npz, plots, logs
# =============================================================================

# --- caches ---
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.pytest_cache/

# --- per-tool large outputs (heavy data dirs) ---
# (poolfreq/ promoted to project root 2026-05-28: src/ scripts/ tests/ data/)
tests/logs/
# heavy cn matrices & sim/result artifacts merged from poolfreq/data into root data/
# (*.npz already covered globally below; these catch the non-.npz siblings + dirs)
data/cn_full_*/
data/cn_var_*
data/block_haplotype_cn/
data/sim_chr1/
data/sim_chr1_skewed/
data/calibration_*.json
data/*_manifest.tsv
data/seedmix_S1_*
data/*.tsv.gz
# poolfreq/results merged into root results/
results/seedmix_231*
results/*aggregate*.tsv
panel/imputation/work/
panel/imputation/logs/
pangenie_test/
panel/pangenie_genotyping/data/raw_fastqs/
panel/pangenie_genotyping/logs/
cactus_panel_overlap/data/*.vcf*
cactus_panel_overlap/data/*.fastq*
cactus_panel_overlap/data/*.fq*
cactus_panel_overlap/logs/

# --- general logs ---
logs/
*.out
*.err
*.log

# --- large binary / data formats ---
*.bam
*.bam.bai
*.bai
*.cram
*.crai
*.vcf
*.vcf.gz
*.vcf.gz.tbi
*.tbi
*.fastq.gz
*.fq.gz
*.fastq
*.fq
*.fa
*.fa.fai
*.fai
*.fasta
*.npz
*.npy
*.parquet
*.h5
*.hdf5
*.gfa
*.gfa.gz
*.gbz
*.dist
*.zip
*.cereal
# PanGenie panel kmer table (heavy, regeneratable from PanGenie-index)
panel/pangenie_genotyping/data/pang_*_pangenie_index_*kmers.tsv.gz

# --- per-record TSVs in results dirs (one per sample, MB-scale) ---
results/**/per_sample_*/
results/**/*.tsv

# --- analysis output dirs producing >GB intermediate text files ---
preprocess_qc/output/ld/*_chr*.tsv
preprocess_qc/output/genotyped_qc/
preprocess_qc/output/grenenet_concordance/
preprocess_qc/output/merged_stats/
contamination_test/results/SEEDMIX_*_chr*/
panel/pangenie_genotyping/data/genotyped/
panel/pangenie_genotyping/data/loo_genotyped/
panel/pangenie_genotyping/data/loo_concordance/
panel/pangenie_genotyping/data/loo_concordance_imputed/
panel/pangenie_genotyping/data/preprocessed/
panel/pangenie_genotyping/data/loo_preprocessed/
panel/pangenie_genotyping/data/loo_raw_fastqs/
panel/pangenie_genotyping/data/raw_fastqs/
panel/pangenie_genotyping/data/smoke/
panel/pangenie_genotyping/data/tmp_genotype/
panel/pangenie_genotyping/data/tmp_loo_genotype/
# but keep the small auxiliary id lists + READMEs
!panel/pangenie_genotyping/data/v3/
!panel/pangenie_genotyping/data/merged/cactus_overlap_80.txt
!panel/pangenie_genotyping/data/merged/README*.md
# keep per-SV summary tsv.gz outputs (small, useful)
!preprocess_qc/output/ld/per_sv_max_r2_*.tsv.gz
!preprocess_qc/output/ld/ld_summary*.tsv
!preprocess_qc/output/*_aggregate.tsv

# --- sub-repos (own git history) ---
sims/visor_freqk/

# --- bulky reference/external dirs (not our code) ---
# HapFIRE: bulky vendored tool — ignore wherever it lives (external/, archive/, …)
HapFIRE/
papers/
external/

# --- OS / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# --- claude ---
.claude/

# --- but explicitly KEEP small important data files ---
!data/*.tsv
!data/*.txt
!data/*.csv
!**/manifest*.tsv
!**/missing*.txt
!**/*_ecotypes.txt
!cactus_panel_overlap/data/our_*_to_xwu_*.tsv
!cactus_panel_overlap/data/ecotype_ids_to_keep*.txt

# --- explicitly KEEP small MD5/SHA files for provenance ---
!**/*.md5
!**/*.sha256

# =============================================================================
# 2026-05-26 cleanup: heavy regeneratable intermediates the older rules missed.
# Policy unchanged: track code/docs/notebooks/plots/small-config, not data.
# =============================================================================
# jellyfish dumps (~28 GB)
*.jf
# in-house k-mer index tables (large; regeneratable from PanGenie-index)
panel/pangenie_index/**/*.tsv.gz
# per-sample AF result TSVs + analysis intermediates (regeneratable)
scratch/*.tsv
scratch/*.tsv.gz
scratch/**/*.tsv
scratch/**/*.tsv.gz
panel/arch3/**/*.tsv
panel/arch3/**/*.tsv.gz
# arch3 run artifacts (regeneratable: per-sample validation plots + build sentinels)
panel/arch3/**/*.png
panel/arch3/**/*.done
benchmarks/p80/results/**/*.tsv
panel_overlap_v3_grenenet/data/*.tsv
panel_overlap_135_vs_82/results/*.tsv.gz
# sim truth tables (regeneratable from ancestry tracks + cn_var)
**/recomb_truth.tsv.gz
# pangenie per-class / missingness reports (multi-GB)
panel/pangenie_genotyping/data/v3qc*/**/*.tsv
panel/pangenie_genotyping/data/v3qc*/**/*.txt
# editor/OS sidecars & notebook backups
*.ipynb.bak*
._*

# archived subprojects (archive/): keep their code/docs/notebooks/plots, drop the
# data dumps. The old top-level-anchored data rules don't match under archive/,
# so re-assert the repo's keep-code-not-data policy here for the moved dirs.
archive/**/*.tsv
archive/**/*.tsv.gz
archive/**/*.txt
archive/**/*.gz

# --- benchmark result TSVs (per-record AF, MB-scale per file; regeneratable) ---
benchmarks/p80/results/cactus_em_*/
benchmarks/p231/results/kmate_global_*/
# kept-on-disk OLD npz-mask snapshots
*.OLD_no_called_mask

# --- sim outputs (large + regeneratable from sim scripts) ---
benchmarks/p231/sims/
benchmarks/p80/sims/*/recomb_truth*.tsv.gz
benchmarks/p80/sims/*/ancestry.tsv
benchmarks/p80/sims/*/visor_pool_fractions.tsv
benchmarks/p80/sims/*/source_weights.tsv
benchmarks/p80/sims/*/pool_weights.tsv
benchmarks/p80/sims/*/region.bed
benchmarks/p80/sims/*/haps/
benchmarks/p80/sims/*/reads/
benchmarks/p80/sims/*/bam/
benchmarks/p231/scripts/__pycache__/

# --- scratch/work dirs (transient h_fixes investigation outputs) ---
scratch/

# --- python venv (test fixtures, site-packages, no business in git) ---
.venv/
venv/

# --- re-ignore data artifacts merged from poolfreq/data that the broad
#     !data/*.tsv keep above would otherwise expose (2026-05-28) ---
data/*_manifest.tsv
data/seedmix_S1_h_wls_*.tsv

# --- macOS AppleDouble + Jupyter checkpoints (junk, never tracked) ---
._*
.ipynb_checkpoints/

# =============================================================================
# 2026-05-29: close big-file gaps after the cn_full->kmer_pa / cn_var->var_pa
# rename + leftover analysis working dirs. Goal: NO large/data file is ever
# stageable. Policy unchanged: track code/docs/notebooks/plots/small-config only.
# =============================================================================
# renamed production matrix dirs (parallel to the old data/cn_full_*/ + cn_var_*)
data/kmer_pa_*/
data/var_pa_*
# bcftools/htslib index + targets sidecars (data, regeneratable)
*.csi
*.targets
*.targets.gz
*.targets.targets
# contamination_test/: untracked analysis working dir (~60 MB of AF/site TSVs).
# Nothing in it is tracked; it's regeneratable scratch. Ignore wholesale — if a
# specific script there ever needs tracking, force-add it explicitly.
contamination_test/
# belt-and-suspenders: AF result TSVs anywhere (one per sample, MB-scale)
*.af.tsv

# =============================================================================
# 2026-06-03: close remaining data leaks found in a pre-GEA repo audit. A bare
# `git add -A` was staging ~2.1 GB of regeneratable data. Policy unchanged:
# track code/docs/notebooks/plots/small-config, never bulk data. Rules are
# SURGICAL — small tracked summary/weight .tsv under benchmarks/ stay tracked.
# =============================================================================
# pickled caches (e.g. results/grenenet_gea/group_means.pkl 1.3G, p0_*.pkl); the
# .npz twins were already ignored — the .pkl siblings slipped through
*.pkl
# SAM (intermediate alignment text; *.bam/*.cram already ignored)
*.sam
# the root results/**/*.tsv rule did NOT cover gzipped result tables
results/**/*.tsv.gz
# benchmarks/ has nested results/ dirs the root-anchored results/** rules miss.
# Target only the bulky regeneratable outputs, not the small tracked summaries.
# (3x 95M per-record AF TSVs):
benchmarks/p231/results/seedmix_grid/
# (95M kMate AF tables):
benchmarks/speed_vs_hapfire/results/*.tsv
# (16M hapFIRE SNP-freq dump):
benchmarks/speed_vs_hapfire/results/*_frequency.txt

# =============================================================================
# 2026-06-18: GEA results are bulk derived data (~150 GB: per-sample AF store,
# pool/gen matrices, per-record & per-block tables, LFMM Y matrices). They are
# pushed to the MOI-LAB Drive (push_gea_to_drive.sh), never git. A bare
# `git add -A` was about to stage all of it. Policy unchanged: track only
# code/docs/notebooks under analysis/.
# =============================================================================
# sample manifests (regeneratable sample/path lists)
data/sample_manifest_*.tsv

# =============================================================================
# Packaging (conda-packaging branch)
# =============================================================================
# Python build artifacts — never track
build/
dist/
*.egg-info/
__pycache__/
# BUT: the tiny bundled self-test fixture (`kmate selftest`) must be committed,
# so it ships in the wheel/conda package. Override the global *.npz / *.fq.gz
